{
  "name": "garage-opener-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "pnpm contract:lint && pnpm contract:check && vitest run",
    "test:live": "LIVE_DOOR_TESTS=1 vitest run --config vitest.live.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "contract:lint": "redocly lint --config contract/redocly.yaml contract/bridge.openapi.yaml",
    "contract:generate": "openapi-typescript contract/bridge.openapi.yaml -o src/contract.ts",
    "contract:check": "node scripts/contract-check.mjs",
    "docker:build": "docker build -t garage-opener-bridge:dev ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.4.4",
    "fastify": "^5.6.1",
    "pino": "^10.0.0",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@redocly/cli": "^2.4.0",
    "openapi-typescript": "^7.13.0"
  },
  "description": "Smart garage door bridge for UniFi Protect: verified open/close on a relay and door sensor, alert rules, family invites.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pcrausaz/garage-opener-bridge.git"
  },
  "homepage": "https://garageopener.app/self-hosting",
  "bugs": {
    "url": "https://github.com/pcrausaz/garage-opener-bridge/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
