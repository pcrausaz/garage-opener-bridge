# Garage Opener bridge — self-hosting configuration
# Copy to `.env` NEXT TO docker-compose.yml (never commit it) and fill in the required values at the top.
# In a stack manager (Dockhand, Portainer…) set the same variables in the stack's environment instead.
# Full reference: https://garageopener.app/self-hosting

# ─── Required ────────────────────────────────────────────────────────────────────────────────────────

# The image version to run. `latest` is the right answer for most people: Docker never updates a running
# container by itself, so this only means "the current release, the next time you choose to pull", which
# keeps you on security fixes without following releases. Set an exact X.Y.Z instead if you want upgrades to
# be a decision rather than a side effect of pulling — and do pin if anything auto-pulls for you (Watchtower).
# Either way, read CHANGELOG.md before a pull: anything needing a config change is under
# "Action required", and the bridge refuses to start with a message rather than running degraded.
GARAGE_BRIDGE_TAG=latest

# Your Protect console, with https://. A UDM answers on every VLAN gateway address, so whichever one the
# bridge's host can reach is fine — commonly https://192.168.1.1.
PROTECT_URL=https://192.168.1.1

# Protect API key: console → Settings → Control Plane → Integrations → Create API Key.
# This key can read every camera on the console: treat it like a password to your house.
PROTECT_API_KEY=

# Admin bearer token(s) for your own phones — comma-separated. This is the credential that opens your
# garage door, so generate it, do not invent it:
#     openssl rand -hex 24
# Minimum 24 characters; the bridge refuses to start on anything short or guessable. Family phones do NOT
# need a token here — they join with a one-time invite from the app's Family screen.
BRIDGE_TOKENS=

# Path secret for the Alarm Manager webhook, i.e. the <secret> in
#   http://<bridge-host>:8787/v1/webhooks/alarm-manager/<secret>
#     openssl rand -hex 24
WEBHOOK_SECRET=

# ─── Strongly recommended ────────────────────────────────────────────────────────────────────────────

# Certificate handling for the console:
#   insecure          skip verification — fine on a LAN with the console's self-signed cert, and the
#                     default. The bridge REFUSES it if PROTECT_URL is not a LAN address, because it
#                     would hand your API key to anyone on the path.
#   fingerprint:<..>  pin the console's SHA-256. This is the right answer; capture it with the command in
#                     https://garageopener.app/self-hosting#certs (openssl's output pastes as is).
#   system            normal CA verification; only if your console has a real certificate.
PROTECT_TLS=insecure

# Your timezone, for the nightly check and for timestamps in the activity log.
TZ=UTC

# ─── Optional ────────────────────────────────────────────────────────────────────────────────────────

# The address the app should use for this bridge, embedded in the invite links you generate. Set it when
# the bridge is reached at something other than its LAN address — a tunnel hostname, a reverse proxy — AND
# whenever you publish ports instead of using host networking: the bridge then only sees its container address.
# PUBLIC_URL=https://garage.example.com

# Set to true ONLY when a reverse proxy or tunnel you control sits in front and sets X-Forwarded-For.
# Without it every request looks like it comes from the proxy, so the per-address limits on invite claims
# and the webhook collapse into one shared bucket for your whole household. With it set when nothing
# strips the header, a caller can forge its own address. See https://garageopener.app/self-hosting.
# TRUST_PROXY=false

# mDNS advertising, so the app finds the bridge without typing an address. Needs host networking.
# BONJOUR=true

# Door mapping. Leave all of these unset: the bridge discovers them when the console has exactly one
# relay output of type garageDoor and one sensor mounted as "garage", which is the normal case. Pin them
# only if discovery reports more than one candidate — the app's Settings screen shows the ids.
# DOOR_RELAY_ID=
# DOOR_OUTPUT_ID=0
# DOOR_SENSOR_ID=
# DOOR_INTERIOR_CAMERA_ID=
# DOOR_DRIVEWAY_CAMERA_ID=

# How long your door takes to travel end to end, and how long after that to re-read the sensor.
# DOOR_TRAVEL_SECONDS=15
# DOOR_VERIFY_AFTER_SECONDS=3

# Relay press. On Protect 7.2.x the USL-Relay's `activate` TOGGLES the output rather than pulsing it, so
# the bridge emulates a press by activating and releasing (ADR-0010). Leave this alone unless your relay
# genuinely pulses, in which case `native` with the console's own pulseDuration is correct.
# RELAY_PULSE_MODE=emulated
# RELAY_PULSE_MS=800
# RELAY_RELEASE_MS=300

# Alert rules.
# ALERT_OPEN_TOO_LONG_MINUTES=15
# ALERT_NIGHTLY_TIME=22:00
# ALERT_NIGHTLY_AUTOCLOSE=false
# ALERT_VEHICLE_GRACE_SECONDS=120

# Activity log retention in days. 0 (the default) keeps every row forever.
# AUDIT_RETENTION_DAYS=0

# Concurrent event streams allowed per token and in total.
# SSE_MAX_PER_TOKEN=8
# SSE_MAX_TOTAL=64

# Licence-plate rules, off by default. Requires a camera with vehicle/LPR smart detection.
# FEATURES_LPR=false
# LPR_KNOWN_PLATES=

# ntfy: push alerts to a phone that is asleep or away (the app alone only alerts while it runs or refreshes).
# The bridge publishes only when BOTH NTFY_URL and NTFY_TOPIC are set. Steps, including the ntfy user and token:
# https://garageopener.app/self-hosting#alerts
#   ntfy.sh:      NTFY_URL=https://ntfy.sh and a long random NTFY_TOPIC; no token.
#   your own:     `--profile ntfy`. NTFY_URL is where the bridge publishes: http://127.0.0.1:8788 with host
#                 networking, http://ntfy:80 with published ports. NTFY_BASE_URL is where your PHONE reaches it.
#                 It denies everyone by default: create a user, grant it the topic, then `ntfy token add`.
# NTFY_URL=http://127.0.0.1:8788
# NTFY_BASE_URL=http://192.168.1.10:8788
# NTFY_TOPIC=          # openssl rand -hex 16
# NTFY_TOKEN=          # tk_… from `docker exec -it garage-ntfy ntfy token add <user>`

# Outbound HMAC-signed events for your own automations (n8n, Home Assistant, a script).
# EVENTS_WEBHOOK_URL=
# EVENTS_WEBHOOK_SECRET=

# LOG_LEVEL=info
